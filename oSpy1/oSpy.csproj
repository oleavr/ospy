<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>oSpy</RootNamespace>
    <AssemblyName>oSpy</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationIcon>oSpy.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>oSpy.snk</AssemblyOriginatorKeyFile>
    <NoWarn>WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Agent/**;ScoutAgent/**;udis86-1.7/**;HeapAgent/**;Tests/**;Tools/**" />
    <EmbeddedResource Remove="Agent/**;ScoutAgent/**;udis86-1.7/**;HeapAgent/**;Tests/**;Tools/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\frida-clr\src\Frida.NET\Frida.NET.csproj" />
    <ProjectReference Include="Tools\AgentBuilder\AgentBuilder.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AgentSource Include="Capture\agent\**\*.ts;Capture\agent\**\*.hexpat" Exclude="Capture\agent\**\*.d.ts" />
    <EmbeddedResource Include="Capture\agent\dist\agent.js">
      <LogicalName>oSpy.Capture.Agent.js</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup>
    <DotnetHost Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</DotnetHost>
    <DotnetHost Condition="'$(DOTNET_HOST_PATH)' == ''">dotnet</DotnetHost>
  </PropertyGroup>

  <Target Name="BuildAgent" AfterTargets="ResolveProjectReferences" BeforeTargets="PrepareResources"
          Inputs="@(AgentSource)" Outputs="Capture\agent\dist\agent.js">
    <MSBuild Projects="Tools\AgentBuilder\AgentBuilder.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" PropertyName="AgentBuilderPath" />
    </MSBuild>
    <Exec Command="&quot;$(DotnetHost)&quot; &quot;$(AgentBuilderPath)&quot; &quot;Capture\agent\index.ts&quot; &quot;Capture\agent\dist\agent.js&quot; &quot;Capture\agent&quot;" />
  </Target>

  <ItemGroup>
    <None Include="..\..\frida-clr\build\win-x64\Frida.dll" Link="Frida.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
